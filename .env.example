# Rain sandbox credentials - TEMPLATE ONLY.
# Copy to .env and fill that in. Never put real values in this file: .env is gitignored,
# this file is not, so anything here gets committed.
RAIN_API_KEY=your_sandbox_api_key
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1

# The API key Rain uses to sign webhooks (its webhookSigning-role key value).
# Defaults to RAIN_API_KEY when the Admin key is also the signing key.
# Copy the FULL value - Rain keys are 40 hex characters. A truncated key produces
# signatures that never match, which looks identical to an attack. Start the server
# with WEBHOOK_DEBUG=true to see which key/encoding Rain actually used.
RAIN_WEBHOOK_SIGNING_KEY=
# Set while rotating signing keys so Secondary-Signature also validates.
RAIN_WEBHOOK_SIGNING_KEY_SECONDARY=

# Chain the company collateral contract is deployed on (base sepolia = 84532).
RAIN_CHAIN_ID=84532
# Wallet that owns the company collateral contract (must be an EVM address).
RAIN_OWNER_ADDRESS=0xYourEvmWalletAddress

# What goes on the card as Rain's single displayName field.
#   business        registered name, or the short trading name when it will not fit (default)
#   business+holder trading name plus the cardholder
#   holder          the cardholder alone, which is Rain's own default
CARD_NAME_MODE=business

PORT=4040
# Reject unsigned webhooks. Only turn off for local replay testing.
WEBHOOK_ENFORCE_SIGNATURE=true
# Log how a failing signature was actually produced (key / payload / encoding).
WEBHOOK_DEBUG=false
