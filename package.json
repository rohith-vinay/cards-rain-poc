{
  "name": "cards-rain-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rain corporate card program - sandbox backend POC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/demo/run.ts",
    "tunnel": "echo 'Run: cloudflared tunnel --url http://localhost:'${PORT:-4000}",
    "seed": "tsx src/demo/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
